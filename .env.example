# ------------------------------------------------------------------
# BuildTrace backend environment configuration
# Copy to backend/.env and adjust. NEVER commit real secrets.
# ------------------------------------------------------------------

# Server
NODE_ENV=development
PORT=5000

# MongoDB connection (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/buildtrace

# Comma-separated list of allowed browser origins (CORS)
CORS_ORIGINS=http://localhost:5173

# Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=20

# Correlation engine
CORRELATION_WINDOW_MINUTES=60
CORRELATION_W_PROXIMITY=0.45
CORRELATION_W_ENVIRONMENT=0.20
CORRELATION_W_SERVICE=0.20
CORRELATION_W_CHANGE_SIGNALS=0.15

# An event received this many minutes after its occurrence is flagged "late"
LATE_EVENT_THRESHOLD_MINUTES=5

# Demo seed password (only used by `npm run seed`)
SEED_PASSWORD=BuildTrace123!
